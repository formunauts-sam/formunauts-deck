{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formunauts.com/present/deck.schema.json",
  "title": "Formunauts Present deck spec",
  "description": "The authoring contract for decks/<id>.deck.js. A deck is declarative data { meta, slides } rendered by the fixed on-brand chrome in template/render.js. This schema encodes per-archetype required/optional fields, the closed enums, numeric bounds, and the brand invariants the validator enforces (no dark chrome; no emoji; no em-dash). See template/DESIGN.md for the human-readable field tables.",
  "type": "object",
  "required": ["meta", "slides"],
  "additionalProperties": false,
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "description": "Non-empty, ordered list of slides. First slide is conventionally a cover, last a closing.",
      "items": { "$ref": "#/$defs/slide" }
    }
  },

  "$defs": {
    "meta": {
      "type": "object",
      "description": "Deck-level metadata. title and imagesBase are required (the two render.js actually reads); id/date/lang are strongly recommended for the library and are validated when present. The rest drive grouping and the calendar handoff.",
      "required": ["title", "imagesBase"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Recommended. Matches the filename decks/<id>.deck.js and the manifest entry. ASCII-safe. When absent, render.js derives the id from the filename.",
          "pattern": "^[0-9A-Za-z._-]+$"
        },
        "title": { "type": "string", "minLength": 1, "description": "Display title (hub, presenter, calendar)." },
        "date": { "type": "string", "minLength": 1, "description": "Recommended. Display date string, e.g. \"15.07.2026\". Not parsed." },
        "lang": { "enum": ["en", "de"], "description": "Recommended. Deck language." },
        "imagesBase": {
          "type": "string",
          "minLength": 1,
          "description": "Base path for this deck's images, e.g. \"./assets/img/<id>/\". All filenames in slides are relative to it.",
          "pattern": "^\\./"
        },
        "occasion": { "type": "string", "description": "Optional. Drives calendar event title and library grouping, e.g. \"All-Hands\"." },
        "durationMin": { "type": "integer", "minimum": 1, "description": "Optional. Talk length in minutes; drives the calendar end time." },
        "owner": { "type": "string", "description": "Optional. Deck owner handle for the library." },
        "status": { "enum": ["draft", "ready", "live", "delivered"], "description": "Optional. Lifecycle state (default \"draft\" when absent)." },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Optional. Free-form library tags." },
        "room": { "type": "string", "description": "Optional. Binds a persistent Engage room code." },
        "cover": { "type": "string", "description": "Optional. Cover image override filename." }
      }
    },

    "chrome": {
      "enum": ["light", "muted", "blue"],
      "description": "Chrome field of a slide. STRICTLY light|muted|blue. dark is removed and the validator rejects it (no-dark brand invariant)."
    },

    "media": {
      "type": "object",
      "description": "One framed media item (never a bare <img>). kind:\"device\" routes through deviceFrame, anything else through assetFrame.",
      "required": ["file"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["asset", "device"], "description": "\"device\" seats the image in hardware/browser chrome (cover-crop); anything else mats it in an aspect frame (contain)." },
        "file": { "type": "string", "minLength": 1, "description": "Filename only, relative to meta.imagesBase. Must be registered in PX/DEVICE_PX in _shared.js for CLS-free sizing." },
        "device": { "enum": ["phone", "browser", "desk"], "description": "device kind only. Frame style. Default browser." },
        "url": { "type": "string", "description": "browser/desk only. Address-bar label (display-only)." },
        "crop": { "enum": ["top", "center", "bottom"], "description": "device kind only. object-position anchor for the cover-crop. Default top." },
        "treatment": { "enum": ["duotone"], "description": "asset kind only. Grayscale + multiply-blue wash for supporting cast." },
        "ratioClass": { "type": "string", "description": "asset kind only. Override the RATIO lookup with an explicit ratio class." },
        "badge": { "$ref": "#/$defs/badge" },
        "alt": { "type": "string", "description": "Accessible label." }
      }
    },

    "badge": {
      "type": "object",
      "description": "Corner badge on a media frame.",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "tone": { "enum": ["success", "planned", "accent"], "description": "Badge colour. Default success." }
      }
    },

    "stat": {
      "type": "object",
      "description": "A giant Chillax numeral. Numeric value counts up automatically.",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["string", "number"], "description": "The numeral. A clean number counts up from 0; anything else renders verbatim." },
        "unit": { "type": "string", "description": "Small unit after the numeral, e.g. \"%\" or \"k\"." },
        "label": { "type": "string", "description": "Caption under the numeral." }
      }
    },

    "comparisonColumn": {
      "type": "object",
      "description": "One side of a comparison. Optional title, an optional single red accent, and a list of rows (string or scored object).",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "description": "Column header." },
        "tone": { "enum": ["accent"], "description": "The one red stopper column (max one; side a wins if both ask)." },
        "items": {
          "type": "array",
          "description": "Rows. A bare string is a plain label; an object adds a 0..1 score bar and/or a figure.",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["label"],
                "additionalProperties": false,
                "properties": {
                  "label": { "type": "string" },
                  "score": { "type": "number", "minimum": 0, "maximum": 1, "description": "0..1 score bar (scaleX)." },
                  "value": { "type": ["string", "number"], "description": "Optional figure shown on the row." }
                }
              }
            ]
          }
        }
      }
    },

    "slideBase": {
      "type": "object",
      "description": "Fields every slide may carry. id + archetype required; the narrative fields (eyebrow/headline/lead) plus notes/timing/chrome are the shared chrome.",
      "required": ["id", "archetype"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique within the deck. ASCII-safe; used as the section DOM id.",
          "pattern": "^[0-9A-Za-z._-]+$"
        },
        "archetype": {
          "enum": [
            "cover", "overviewBullets", "campaignAnalysis", "projectVisual",
            "processDiagram", "nextSteps", "closing", "bentoBoard", "statusBoard",
            "poll", "bigStat", "kpiDashboard", "comparison", "agenda",
            "sectionDivider", "timeline", "pullQuote", "logoWall", "imageFullBleed",
            "map"
          ],
          "description": "Which renderer builds the slide body."
        },
        "eyebrow": { "type": "string", "description": "Small uppercase kicker above the headline." },
        "headline": { "type": "string", "description": "The slide headline (Chillax)." },
        "lead": { "type": "string", "description": "One-line standfirst under the headline." },
        "notes": { "type": "string", "description": "Speaker notes, verbatim, shown in the presenter console (key P)." },
        "timing": { "type": "number", "minimum": 0, "description": "Optional pacing target in seconds for the presenter." },
        "chrome": { "$ref": "#/$defs/chrome" },
        "backdrop": { "enum": ["muted"], "description": "Legacy alias for chrome:\"muted\" (only honoured when chrome is absent). Prefer chrome." }
      }
    },

    "slide": {
      "allOf": [
        { "$ref": "#/$defs/slideBase" },

        {
          "if": { "properties": { "archetype": { "const": "cover" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "sub": { "type": "string", "description": "Sub-line under the headline rule." }
            }
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "closing" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "statement": { "type": "string", "description": "The closing statement (large)." },
              "sub": { "type": "string", "description": "Sub-line under the statement." },
              "site": { "type": "string", "description": "Site line, e.g. \"formunauts.com\"." }
            }
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "overviewBullets" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "variant": { "enum": ["default", "quiet"], "description": "\"quiet\" renders the two-column calm layout instead of numbered bullets." },
              "bullets": { "type": "array", "items": { "type": "string" }, "description": "default variant. Numbered bullet lines." },
              "aside": { "type": "array", "items": { "type": "string" }, "description": "default variant. \"Also shipped\" side panel lines." },
              "columns": {
                "type": "array",
                "description": "quiet variant. Two calm columns.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "title": { "type": "string" },
                    "items": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "campaignAnalysis" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "funnel": {
                "type": "array",
                "description": "Funnel stages, widest first. Numeric value counts up.",
                "items": {
                  "type": "object",
                  "required": ["label", "value"],
                  "additionalProperties": false,
                  "properties": {
                    "label": { "type": "string" },
                    "value": { "type": ["string", "number"] },
                    "note": { "type": "string", "description": "Small note beside the label, e.g. a percentage." },
                    "tip": { "type": "string", "description": "Hover/click tooltip text (interactive funnel)." }
                  }
                }
              },
              "pills": {
                "type": "array",
                "description": "The 2x2 metric-card grid. tone:\"accent\" marks the one red money metric.",
                "items": {
                  "type": "object",
                  "required": ["label", "value"],
                  "additionalProperties": false,
                  "properties": {
                    "label": { "type": "string" },
                    "value": { "type": ["string", "number"] },
                    "tone": { "enum": ["accent"], "description": "Red-accented emphasis card. At most one per deck." }
                  }
                }
              },
              "nextStep": {
                "type": "object",
                "description": "The one sanctioned activity-stripe callout.",
                "additionalProperties": false,
                "properties": {
                  "label": { "type": "string" },
                  "detail": { "type": "string" },
                  "when": { "type": "string" }
                }
              }
            }
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "projectVisual" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "layout": { "enum": ["hero", "masonry", "single"], "description": "Chooses the sub-layout. Absent falls back to single." },
              "hero": {
                "type": "object",
                "description": "hero layout. The live post seated in a phone frame.",
                "required": ["src"],
                "additionalProperties": false,
                "properties": {
                  "src": { "type": "string" },
                  "tag": { "type": "string", "description": "Badge text, e.g. \"LIVE\"." },
                  "tone": { "type": "string", "description": "Legacy badge tone hint (unused by renderer; kept for authoring intent)." }
                }
              },
              "thumbs": {
                "type": "array",
                "description": "hero layout. Planned-post thumbnails.",
                "items": {
                  "type": "object",
                  "required": ["src"],
                  "additionalProperties": false,
                  "properties": {
                    "src": { "type": "string" },
                    "tag": { "type": "string" }
                  }
                }
              },
              "metrics": {
                "type": "array",
                "description": "hero layout. Stat pills; numeric value counts up.",
                "items": {
                  "type": "object",
                  "required": ["value", "label"],
                  "additionalProperties": false,
                  "properties": {
                    "value": { "type": ["string", "number"] },
                    "label": { "type": "string" },
                    "unit": { "type": "string" },
                    "tone": { "enum": ["accent"], "description": "Red-accented emphasis metric." }
                  }
                }
              },
              "band": {
                "type": "object",
                "description": "hero layout. Full-width banner strip.",
                "required": ["src"],
                "additionalProperties": false,
                "properties": {
                  "src": { "type": "string" },
                  "url": { "type": "string" }
                }
              },
              "cadence": { "type": "string", "description": "hero layout. Pulsing cadence chip text." },
              "bullets": {
                "type": "array",
                "description": "single layout (slide 05 style). String or {t, arrow?, tone?}.",
                "items": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "required": ["t"],
                      "additionalProperties": false,
                      "properties": {
                        "t": { "type": "string" },
                        "arrow": { "type": "boolean", "description": "Renders a → mark instead of a dot." },
                        "tone": { "enum": ["accent"], "description": "Red-accented lead line." }
                      }
                    }
                  ]
                }
              },
              "teaser": {
                "type": "object",
                "description": "single layout. Small teaser image beside the bullets.",
                "required": ["src"],
                "additionalProperties": false,
                "properties": { "src": { "type": "string" } }
              },
              "showcase": {
                "type": "object",
                "description": "single layout. One centered showcase image (owns the slide).",
                "required": ["src"],
                "additionalProperties": false,
                "properties": { "src": { "type": "string" } }
              },
              "gallery": {
                "type": "array",
                "description": "masonry layout. Wall tiles. String or {src, feature?, channel?, url?, alt?}.",
                "items": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "required": ["src"],
                      "additionalProperties": false,
                      "properties": {
                        "src": { "type": "string" },
                        "feature": { "type": "boolean", "description": "The one sanctioned cover-crop money shot in the wall." },
                        "channel": { "enum": ["instagram", "linkedin"], "description": "Channel glyph badge." },
                        "url": { "type": "string" },
                        "alt": { "type": "string" }
                      }
                    }
                  ]
                }
              },
              "more": {
                "type": "object",
                "description": "masonry layout. \"+N more\" ghost tile.",
                "additionalProperties": false,
                "properties": {
                  "value": { "type": "string" },
                  "label": { "type": "string" }
                }
              }
            }
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "processDiagram" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "steps": {
                "type": "array",
                "description": "Ordered process steps joined by blue arrows.",
                "items": {
                  "type": "object",
                  "required": ["label"],
                  "additionalProperties": false,
                  "properties": {
                    "n": { "type": ["string", "number"], "description": "Step number label (defaults to position)." },
                    "label": { "type": "string" },
                    "sub": { "type": "string" },
                    "icon": { "enum": ["database", "scan-search", "sparkles", "camera", "globe", "git-branch"], "description": "Lucide glyph id; must exist in the ICONS map in _shared.js." }
                  }
                }
              },
              "footnote": { "type": "string", "description": "Optional footnote under the process." }
            }
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "nextSteps" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "columns": {
                "type": "array",
                "description": "Timeline lanes. tone:\"muted\" is the ongoing (dashed) lane; anything else is the active (blue) lane.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "title": { "type": "string" },
                    "tone": { "enum": ["active", "muted"], "description": "Lane style. muted = ongoing/dashed; active (or absent) = forward/blue." },
                    "items": {
                      "type": "array",
                      "description": "Lane nodes. String or {t, icon?, when?}.",
                      "items": {
                        "oneOf": [
                          { "type": "string" },
                          {
                            "type": "object",
                            "required": ["t"],
                            "additionalProperties": false,
                            "properties": {
                              "t": { "type": "string" },
                              "icon": { "enum": ["database", "scan-search", "sparkles", "camera", "globe", "git-branch"], "description": "Lucide glyph id from ICONS." },
                              "when": { "type": "string", "description": "Datestamp tag, e.g. \"~1 wk\"." }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "bentoBoard" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "meter": {
                "type": "object",
                "description": "Optional completion meter across the top.",
                "additionalProperties": false,
                "properties": {
                  "done": { "type": "number" },
                  "total": { "type": "number" },
                  "label": { "type": "string" }
                }
              },
              "tiles": {
                "type": "array",
                "description": "White cards placed on a 12-column bento grid.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "span": { "type": "integer", "minimum": 1, "maximum": 12, "description": "Column span 1..12 (clamped; default 6 for hero, else 4)." },
                    "rowspan": { "type": "integer", "minimum": 1, "maximum": 4, "description": "Row span 1..4 (clamped; default 1)." },
                    "tone": { "enum": ["hero", "accent", "ghost", "plain"], "description": "Emphasis. Default plain." },
                    "state": { "enum": ["done", "active", "next"], "description": "Status dot + pill." },
                    "stateLabel": { "type": "string", "description": "Override the pill text (defaults to state)." },
                    "eyebrow": { "type": "string" },
                    "title": { "type": "string" },
                    "text": { "type": "string" },
                    "stat": { "$ref": "#/$defs/stat" },
                    "media": { "$ref": "#/$defs/media" }
                  }
                }
              }
            }
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "statusBoard" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "description": "DEPRECATED: statusBoard defaults to a dark board and is being retired. Migrate to bentoBoard with tile state tones. Kept for validation of in-flight decks only.",
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "groups": {
                "type": "array",
                "description": "DEPRECATED. Status columns of {title, items:[{t, state}]}.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "title": { "type": "string" },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["t"],
                        "additionalProperties": false,
                        "properties": {
                          "t": { "type": "string" },
                          "state": { "enum": ["done", "active", "next"] }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "poll" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "description": "Engage-native poll slide. Poses a question and options on-brand; reaching it auto-opens the poll to viewers, and live votes fill each option's result bar. The option id is the vote token the authority tallies.",
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "question": { "type": "string", "description": "The poll prompt shown on the slide (falls back to headline when absent)." },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 6,
                "description": "The poll options (2..6). Each needs a stable ASCII id (the vote token) and a display label.",
                "items": {
                  "type": "object",
                  "required": ["id", "label"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "string", "pattern": "^[0-9A-Za-z._-]+$", "description": "Stable ASCII option id; becomes the vote token the authority tallies." },
                    "label": { "type": "string", "minLength": 1, "description": "What the audience reads for this option." }
                  }
                }
              }
            }
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "bigStat" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "value": { "type": ["string", "number"], "description": "The hero figure. A clean integer counts up (0 to value); a decimal or string (e.g. \"1.8M\") renders literally, no count-up." },
              "unit": { "type": "string", "description": "Optional unit beside the hero numeral, e.g. \"%\", \"EUR\", \"k\"." },
              "label": { "type": "string", "minLength": 1, "description": "The one-line meaning of the number (what it measures)." },
              "context": { "type": "string", "description": "Optional second line of context under the label." },
              "sub": {
                "type": "object",
                "description": "Optional supporting sub-stat (a smaller second figure).",
                "required": ["value", "label"],
                "additionalProperties": false,
                "properties": {
                  "value": { "type": ["string", "number"], "description": "Sub-figure; clean integers count up." },
                  "label": { "type": "string", "description": "What the sub-figure measures." }
                }
              },
              "spark": {
                "type": "array",
                "description": "Optional thin sparkbar (up to 12 numeric values; drawn in, normalized to the max). Wins over ring if both are given.",
                "items": { "type": "number" },
                "maxItems": 12
              },
              "ring": { "type": "number", "minimum": 0, "maximum": 1, "description": "Optional thin draw-in accent ring; 0..1 sets the arc sweep. Ignored when spark is present." }
            },
            "required": ["value", "label"]
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "kpiDashboard" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "metrics": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "description": "3..6 metric cells. Each boots a count-up numeral, an optional scaleX meter, and an optional draw-in ring together on entry.",
                "items": {
                  "type": "object",
                  "required": ["value", "label"],
                  "additionalProperties": false,
                  "properties": {
                    "value": { "type": ["string", "number"], "description": "Cell figure. Clean integer counts up; decimal/string renders literally." },
                    "unit": { "type": "string", "description": "Optional unit beside the numeral, e.g. \"%\", \"k\"." },
                    "label": { "type": "string", "minLength": 1, "description": "What the cell measures." },
                    "meter": { "type": "number", "minimum": 0, "maximum": 1, "description": "Optional meter fill 0..1 (scaleX)." },
                    "ring": { "type": "number", "minimum": 0, "maximum": 1, "description": "Optional draw-in ring 0..1 (arc sweep)." },
                    "tone": { "enum": ["accent"], "description": "Red money-metric accent. At most one per surface; the renderer honours only the first accent cell." }
                  }
                }
              }
            },
            "required": ["metrics"]
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "comparison" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "a": { "$ref": "#/$defs/comparisonColumn" },
              "b": { "$ref": "#/$defs/comparisonColumn" }
            },
            "required": ["a", "b"]
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "agenda" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "items": {
                "type": "array",
                "description": "Numbered section list that doubles as a nav map. Each line can FLIP-morph into the matching sectionDivider (same number).",
                "items": {
                  "oneOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "required": ["title"],
                      "additionalProperties": false,
                      "properties": {
                        "n": { "type": ["string", "number"], "description": "Section number (defaults to 1-based position). Morph anchor: pairs with a sectionDivider's number via data-id=\"agenda-<n>\"." },
                        "title": { "type": "string", "description": "Section title." },
                        "note": { "type": "string", "description": "Small note under the title (duration, sub-topic)." }
                      }
                    }
                  ]
                }
              }
            }
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "sectionDivider" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "description": "Full-bleed blue section interstitial. The title carries data-id=\"agenda-<number>\" so a matching agenda line FLIP-morphs into it (reveal auto-animate). Owns its whole body; no shared chrome.",
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "number": { "type": ["string", "number"], "description": "Section number. Fills the giant ghost numeral AND is the morph anchor: pairs with an agenda line via data-id=\"agenda-<number>\"." },
              "title": { "type": "string", "description": "Section title, lands as the large headline (the morph destination)." },
              "sub": { "type": "string", "description": "Optional sub-line under the title." }
            }
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "timeline" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "orientation": { "enum": ["horizontal", "vertical"], "description": "Spine direction. Default horizontal (nodes spread L->R); vertical stacks top->bottom on the left rail." },
              "milestones": {
                "type": "array",
                "description": "Ordered milestones the self-drawing spine passes; each fades up in sequence.",
                "items": {
                  "type": "object",
                  "required": ["title"],
                  "additionalProperties": false,
                  "properties": {
                    "when": { "type": "string", "description": "Datestamp tag, e.g. \"Q3\" or \"~1 wk\"." },
                    "title": { "type": "string", "description": "Milestone title." },
                    "note": { "type": "string", "description": "Small supporting note." },
                    "state": { "enum": ["done", "active", "next"], "description": "Milestone state (dot styling). Default next." }
                  }
                }
              }
            }
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "pullQuote" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "quote": { "type": "string", "description": "The quote body (Chillax display). Rendered in clause-sized word-groups that fade up in sequence." },
              "cite": { "type": "string", "description": "Attribution name." },
              "role": { "type": "string", "description": "Attribution role/context under the name." },
              "portrait": {
                "type": "object",
                "description": "Optional portrait, revealed with a clip-path wipe. ONE framed media (never a bare <img>).",
                "required": ["file"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "enum": ["asset", "device"], "description": "\"device\" seats the portrait in hardware chrome (cover-crop); \"asset\" mats it (contain). Default device." },
                  "file": { "type": "string", "minLength": 1, "description": "Filename only, relative to meta.imagesBase. Must be registered in PX/DEVICE_PX in _shared.js." },
                  "device": { "enum": ["phone", "browser", "desk"], "description": "device kind only. Frame style. Default phone." },
                  "crop": { "enum": ["top", "center", "bottom"], "description": "device kind only. Cover-crop anchor. Default center." },
                  "ratioClass": { "type": "string", "description": "asset kind only. Override the RATIO lookup." },
                  "alt": { "type": "string", "description": "Accessible label." }
                }
              }
            }
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "logoWall" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "logos": {
                "type": "array",
                "description": "Partner/charity marks. Each mats in a contain frame so mixed shapes coexist. Hovering one spotlights it (dims the rest).",
                "items": {
                  "type": "object",
                  "required": ["src"],
                  "additionalProperties": false,
                  "properties": {
                    "src": { "type": "string", "minLength": 1, "description": "Filename only, relative to meta.imagesBase." },
                    "alt": { "type": "string", "description": "Accessible label. Defaults to a de-slugged filename." },
                    "url": { "type": "string", "description": "Display-only caption label under the mark (e.g. the org name)." }
                  }
                }
              }
            }
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "imageFullBleed" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "src": { "type": "string", "minLength": 1, "description": "Filename only, relative to meta.imagesBase. Registered in PX/DEVICE_PX for CLS-free sizing. Cover-cropped edge to edge." },
              "alt": { "type": "string", "description": "Accessible label for the photo." },
              "title": { "type": "string", "description": "Over-scrim headline (distinct from the shared chrome headline)." },
              "caption": { "type": "string", "description": "Caption line inside the scrim." },
              "credit": { "type": "string", "description": "Small photo credit under the caption." },
              "focal": { "enum": ["top", "center", "bottom"], "description": "object-position anchor for the cover-crop. Default center." }
            }
          }
        },

        {
          "if": { "properties": { "archetype": { "const": "map" } }, "required": ["archetype"] },
          "then": {
            "additionalProperties": false,
            "properties": {
              "id": true, "archetype": true, "eyebrow": true, "headline": true,
              "lead": true, "notes": true, "timing": true, "chrome": true, "backdrop": true,
              "region": { "enum": ["at", "ch", "eu"], "description": "Which stylised outline to draw. Default at. Not to scale." },
              "pins": {
                "type": "array",
                "description": "Location pins in 0..100 viewBox percentages. At most one tone:\"accent\" (the red stopper).",
                "items": {
                  "type": "object",
                  "required": ["x", "y", "label"],
                  "additionalProperties": false,
                  "properties": {
                    "x": { "type": "number", "minimum": 0, "maximum": 100, "description": "Horizontal percent (0 left .. 100 right)." },
                    "y": { "type": "number", "minimum": 0, "maximum": 100, "description": "Vertical percent (0 top .. 100 bottom)." },
                    "label": { "type": "string", "minLength": 1, "description": "Pin label (real type, not SVG text)." },
                    "tone": { "enum": ["accent"], "description": "Red-accented pin. At most one per surface." }
                  }
                }
              },
              "routes": {
                "type": "array",
                "description": "Drawn arcs between pins, by index into pins[]. Dangling indices are skipped.",
                "items": {
                  "type": "object",
                  "required": ["from", "to"],
                  "additionalProperties": false,
                  "properties": {
                    "from": { "type": "integer", "minimum": 0, "description": "Index of the origin pin." },
                    "to": { "type": "integer", "minimum": 0, "description": "Index of the destination pin." }
                  }
                }
              },
              "caption": { "type": "string", "description": "Small footnote under the map." }
            }
          }
        }
      ]
    }
  }
}
